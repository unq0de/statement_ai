# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
NUM_PROXIES=0

# Web server (gunicorn)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
# Extra gunicorn arguments. --reload picks up code changes in development; keep empty in production.
GUNICORN_EXTRA_ARGS=--reload

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_CHECK_USER_ATTRIBUTES=1
PASSWORD_CHECK_COMMON=1
PASSWORD_CHECK_NUMERIC=1
PASSWORD_CHECK_SPECIAL_CHARACTERS=1

# Password reset email (use the console backend in DEBUG mode)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
EMAIL_USE_HTML_TEMPLATES=0
DEFAULT_FROM_EMAIL=Statement AI <no-reply@example.com>
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_URL=https://app.example.com/reset-password/
REGISTRATION_CONFIRMATION_URL=https://app.example.com/confirm-email/
TWO_FACTOR_ENABLED=1
TWO_FACTOR_ISSUER=Statement AI
# Optional; if unset, this key is derived from SECRET_KEY. Keep it stable to preserve enrolled devices.
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_CHALLENGE_TIMEOUT_SECONDS=300
TWO_FACTOR_MAX_CHALLENGE_ATTEMPTS=5
TWO_FACTOR_RECOVERY_CODE_COUNT=10

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
API_USAGE_TRACKING_ENABLED=1
API_USAGE_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
GEMINI_MONTHLY_LIMIT_PER_USER=0

# GDPR data retention (days a bank statement is kept before auto-deletion)
DATA_RETENTION_DAYS=1


# Comma-separated list of allowed hosts, e.g. api.example.com
ALLOWED_HOSTS=

# Comma-separated list of allowed CORS origins, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=

# --- Database ---

# "local" (default) uses the docker-compose "db" Postgres container.
# "supabase" uses a hosted Supabase Postgres instance instead - see README
# section "Using Supabase instead of the local Postgres container".
DB_ENGINE=local

# PostgreSQL credentials (must match between the db and web/cron services)
# Only used when DB_ENGINE=local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=statement_ai_db
POSTGRES_USER=statement_ai_user
POSTGRES_PASSWORD=Test123!

# Supabase connection (only used when DB_ENGINE=supabase)
# Get these from: Supabase Dashboard -> Project Settings -> Database
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
